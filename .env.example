# Database — dummy local defaults. Match docker-compose.yml and appsettings.Development.json.
# The scaffold works with no .env. Copy this to .env only to override (`.env` is gitignored).
# Never put a real password here and never commit `.env`.
POSTGRES_USER=tadka
POSTGRES_PASSWORD=tadka_local
POSTGRES_DB=tadka

# Optional app override (wins over appsettings.Development.json):
# ConnectionStrings__TadkaDb=Host=localhost;Port=5432;Database=tadka;Username=tadka;Password=tadka_local
