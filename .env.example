# Tadka local overrides — copy to .env only when you need non-defaults.
# docker-compose.yml and appsettings.Development.json already use these values.

# ── Infra (compose) ──────────────────────────────────────────
POSTGRES_USER=tadka
POSTGRES_PASSWORD=tadka_local
POSTGRES_DB=tadka
PAYMENT_DB=tadka_payment
DELIVERY_DB=tadka_delivery
RESTAURANT_DB=tadka_restaurant

# ── Demo levers (env overrides for dotnet run / containers) ──
# Restaurant accept/reject (ADR-045/062)
# Restaurant__DecisionMode=Inline          # Inline (tests) | Service (Restaurant.Api decides)
# Restaurant__AcceptMode=Auto              # Auto | Reject  (set on Ordering when Inline; on Restaurant.Api when Service)
# Restaurant__RefundOnReject=true          # false = stuck-money break
# Restaurant__Buggy=false                  # true = canary destination returns 500 (ADR-061)

# Saga (ADR-045/046)
# Saga__Mode=Choreography                  # Choreography | Orchestration (persists ordering.saga_instances)

# Payment (ADR-021/023)
# Payment__Mode=Async
# Payment__Gateway__Behavior=Fast          # Fast | Slow | Failing
# Payment__TimeoutSeconds=2
# Payment__CrashOnCharge=false

# Load / resilience (ADR-059/060)
# Backpressure__MaxConcurrent=0            # 0 = off; e.g. 20 under dinner-rush
# LoadShed__Enabled=false
# LoadShed__Force=false

# Feature flags / canary (ADR-058/061)
# Flags__UseNewMenuPath=0                  # 0–100 percentage
# Flags__CanaryRestaurant=0

# Expand-contract dual-write (ADR-038) — Restaurant.Api
# Demo__DualWriteDisplayName=false

# Observability (ADR-040) — leave unset for quiet local; set for Jaeger
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Connection strings (already in appsettings.Development.json)
# ConnectionStrings__TadkaDb=Host=localhost;Port=5432;Database=tadka;Username=tadka;Password=tadka_local
# ConnectionStrings__Redis=localhost:6379,abortConnect=false
# Kafka__BootstrapServers=localhost:9092
