# Database — these defaults match docker-compose.yml and appsettings.Development.json.
# Copy to .env only if you want to override them; the scaffold works with no .env.
POSTGRES_USER=tadka
POSTGRES_PASSWORD=tadka_local
POSTGRES_DB=tadka

# The .NET app reads this connection string (already set in appsettings.Development.json):
# ConnectionStrings__TadkaDb=Host=localhost;Port=5432;Database=tadka;Username=tadka;Password=tadka_local
