{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose ps *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(**/TestResults/**)",
      "Read(./evolution/results/**)",
      "Read(./k6/reports/**)"
    ]
  },
  "env": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  }
}
