{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Information" } },
  "AllowedHosts": "*",
  "Gateway": { "RateLimitPerMinute": 120 },
  "ReverseProxy": {
    "Routes": {
      "payments": {
        "ClusterId": "payment",
        "Order": 1,
        "Match": { "Path": "/api/v1/payments/{**remainder}" },
        "Transforms": [ { "PathPattern": "/payments/{**remainder}" } ]
      },
      "deliveries": {
        "ClusterId": "delivery",
        "Order": 1,
        "Match": { "Path": "/api/v1/deliveries/{**remainder}" }
      },
      "restaurants": {
        "ClusterId": "restaurant",
        "Order": 1,
        "Match": { "Path": "/api/v1/restaurants/{**remainder}" }
      },
      "monolith": {
        "ClusterId": "monolith",
        "Order": 2,
        "Match": { "Path": "/api/v1/{**remainder}" }
      }
    },
    "Clusters": {
      "monolith": { "Destinations": { "d1": { "Address": "http://localhost:5224/" } } },
      "payment": { "Destinations": { "d1": { "Address": "http://localhost:5240/" } } },
      "delivery": { "Destinations": { "d1": { "Address": "http://localhost:5250/" } } },
      "restaurant": { "Destinations": { "d1": { "Address": "http://localhost:5260/" } } }
    }
  }
}
