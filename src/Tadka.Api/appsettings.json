{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "tadka",
    "Audience": "tadka",
    "SigningKey": "tadka-dev-signing-key-change-in-prod-0123456789abcdef",
    "AccessTokenMinutes": 15
  },
  "Restaurant": {
    "AcceptMode": "Auto",
    "RefundOnReject": true
  },
  "Saga": {
    "Mode": "Choreography"
  },
  "RateLimit": {
    "PerMinute": 120,
    "Algorithm": "FixedWindow"
  },
  "Backpressure": {
    "MaxConcurrent": 0
  },
  "LoadShed": {
    "Enabled": false,
    "Force": false
  },
  "Flags": {
    "UseNewMenuPath": 0,
    "CanaryRestaurant": 0
  },
  "Demo": {
    "DispatchEventsBeforeCommit": false,
    "NotificationDelayMs": 0,
    "EncryptPiiAtRest": true
  }
}
