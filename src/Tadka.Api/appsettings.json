{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "tadka",
    "Audience": "tadka",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "RateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 10
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutSeconds": 60
    }
  },
  "Restaurant": {
    "DecisionMode": "Inline",
    "AcceptMode": "Auto",
    "RefundOnReject": true
  },
  "Saga": {
    "Mode": "Choreography"
  },
  "RateLimit": {
    "PerMinute": 120,
    "Algorithm": "FixedWindow"
  },
  "Backpressure": {
    "MaxConcurrent": 0
  },
  "LoadShed": {
    "Enabled": false,
    "Force": false
  },
  "Flags": {
    "UseNewMenuPath": 0,
    "CanaryRestaurant": 0
  },
  "Demo": {
    "DispatchEventsBeforeCommit": false,
    "NotificationDelayMs": 0,
    "EncryptPiiAtRest": true
  }
}
