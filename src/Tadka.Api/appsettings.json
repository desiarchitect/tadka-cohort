{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "tadka",
    "Audience": "tadka",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "RateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 10
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutSeconds": 60
    }
  }
}
