{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TadkaDb": "Host=localhost;Port=5432;Database=tadka;Username=tadka;Password=tadka_local;Minimum Pool Size=5;Maximum Pool Size=50",
    "TadkaDbReplica": "Host=localhost;Port=5433;Database=tadka;Username=tadka;Password=tadka_local;Maximum Pool Size=50",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "tadka-monolith"
  },
  "Restaurant": {
    "DecisionMode": "Inline",
    "AcceptMode": "Auto",
    "RefundOnReject": true
  },
  "Saga": {
    "Mode": "Choreography"
  },
  "Backpressure": {
    "MaxConcurrent": 0
  },
  "LoadShed": {
    "Enabled": false
  },
  "Flags": {
    "UseNewMenuPath": 0
  },
  "Demo": {
    "DispatchEventsBeforeCommit": false,
    "NotificationDelayMs": 0
  }
}
